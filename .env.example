# ---------------------------------------------------------------------------
# FOOD FEST – LUCKY SPIN SYSTEM : environment variables
# Copy this file to .env and fill in the values you need.
# ---------------------------------------------------------------------------

# API server
PORT=4000
# Comma separated list of allowed browser origins (dev server + production web)
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# JWT secret used to sign admin sessions. CHANGE THIS IN PRODUCTION.
JWT_SECRET=change-me-please-use-a-long-random-string
JWT_EXPIRES_IN=12h

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# 1) Supabase / PostgreSQL: set DATABASE_URL to the connection string from
#    Supabase Dashboard -> Project Settings -> Database -> Connection string
#    (use the "Session pooler" URI, it already contains the password).
#    Example:
#    DATABASE_URL=postgresql://postgres.abcdefgh:YOUR-PASSWORD@aws-0-eu-central-1.pooler.supabase.com:5432/postgres
#
# 2) Local development without Supabase: leave DATABASE_URL empty and the
#    server boots an embedded PostgreSQL (PGlite) stored in ./.data/pglite.
#    The exact same SQL migrations run in both cases.
DATABASE_URL=
PGLITE_PATH=./.data/pglite

# ---------------------------------------------------------------------------
# First admin account (created by `npm run seed` if it does not exist yet)
# ---------------------------------------------------------------------------
ADMIN_EMAIL=admin@foodfest.local
ADMIN_PASSWORD=admin12345
ADMIN_NAME=Food Fest Admin

# ---------------------------------------------------------------------------
# ESP32 device authentication
# The firmware must send this value in the x-device-token header.
# Generate a long random string for production and flash the same value.
# ---------------------------------------------------------------------------
DEVICE_TOKEN=dev-device-token-change-me
DEVICE_ID=FOODFEST_ESP32
